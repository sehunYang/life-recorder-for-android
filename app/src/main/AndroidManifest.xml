<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 어느 앱이 앞에 떠 있었는지(UsageEvents)를 읽기 위해. 설정 > 사용 정보 접근에서 사용자가 허용한다 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 그 앱의 이름("카카오톡")을 패키지명 옆에 붙이기 위해. 직접 빌드해 쓰는 앱이라 스토어 제약과 무관하다 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 삼성 통화 녹음(공용 저장소 Recordings/Call)을 읽어 함께 업로드하기 위해 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- 카메라로 찍은 사진·동영상(DCIM/Camera)을 복사해 함께 업로드하기 위해 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- 문자 메시지 하루치 JSONL 내보내기. 연락처는 번호 옆에 이름을 붙이기 위한 선택 권한 -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".LifeRecorderApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeRecorder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 잠금 해제 후 화면 녹화를 되살릴 때만 잠깐 떴다 사라지는 동의 전용 창 -->
        <activity
            android:name=".service.ProjectionRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection"
            android:stopWithTask="false" />

        <!-- 카카오톡 알림 가로채기. 설정 > 알림 > 알림 접근에서 사용자가 직접 켜야 한다. -->
        <service
            android:name=".kakao.KakaoNotificationListener"
            android:exported="true"
            android:label="Life Recorder (카카오톡 기록)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 화면의 글자 읽기 (앱을 가리지 않는다). 설정 > 접근성에서 사용자가 직접 켜야 한다.
             카카오톡이면 알림에 안 오는 내 발화·그룹방 이름이, 다른 앱이면 문서·게시글이 OCR 없이 온다. -->
        <service
            android:name=".kakao.ScreenTextService"
            android:exported="true"
            android:label="Life Recorder (화면 글자 읽기)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_text_accessibility" />
        </service>

        <!-- 카카오톡 대화 내용 내보내기 → 다른 앱으로 공유 → Life Recorder -->
        <activity
            android:name=".kakao.KakaoImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Life Recorder로 가져오기"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- 카카오톡 내보내기는 버전에 따라 txt 한 개, zip 한 개(application/zip 또는
                 application/x-zip-compressed), 여러 파일(타입이 */*로 잡힌다), 또는 본문 텍스트로
                 제각각 나온다. 어느 쪽이든 놓치지 않도록 종류를 가리지 않고 받는다.
                 어차피 이 앱은 받은 것을 변환 없이 그대로 올리기만 한다. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 홈 화면 위젯. 누를 때마다 기록이 켜지고 꺼진다. 가로 2x1과 세로 1x2 두 가지다.
             위젯 고르는 화면에 두 크기를 따로 내보이려면 provider도 둘이어야 한다. -->
        <receiver
            android:name=".widget.RecordWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_record_info" />
        </receiver>

        <receiver
            android:name=".widget.RecordWidgetTall"
            android:exported="true"
            android:label="@string/widget_label_tall">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_record_tall_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
