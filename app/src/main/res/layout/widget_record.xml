<?xml version="1.0" encoding="utf-8"?>
<!--
  2x1 위젯. 칸 하나가 좁아서 아이콘 하나에 글자 두 줄만 둔다.
  위젯 전체가 하나의 버튼이다 (누르면 기록 시작, 다시 누르면 중지).
  배경은 ImageView로 깐다. RemoteViews로 확실히 바꿀 수 있는 것은 이미지와 글자뿐이라,
  켜짐/꺼짐 색은 그림 자체를 갈아 끼워 바꾼다.
  여기 적힌 값은 "꺼짐" 상태이자 위젯 고르는 화면의 미리보기다. 실제 값은 코드가 덮어쓴다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_off" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_label"
            android:src="@drawable/ic_mic_dim" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_off_title"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_off_sub"
                android:textColor="#FF9AA0A6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
