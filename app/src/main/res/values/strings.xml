<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Life Recorder</string>

    <!-- 설정 > 접근성에 보이는 설명. 다른 앱은 읽지 않는다는 것을 여기서 밝힌다. -->
    <string name="a11y_description">카카오톡 화면에 보이는 글자를 하루치 파일로 모읍니다. 내가 보낸 메시지와 방 이름을 알림만으로는 얻을 수 없어서 씁니다. 카카오톡 외의 앱 화면은 읽지 않습니다.</string>

    <!-- 위젯 고르는 화면에 보이는 이름과 설명 -->
    <string name="widget_label">기록 시작·중지</string>
    <string name="widget_description">한 번 눌러 기록을 시작하고, 한 번 더 눌러 끕니다.</string>

    <!-- 위젯에 적히는 글. 켜짐 쪽은 상황에 따라 코드가 골라 넣는다. -->
    <string name="widget_off_title">기록 꺼짐</string>
    <string name="widget_off_sub">눌러서 시작</string>
    <string name="widget_on_title">기록 중</string>
    <string name="widget_on_sub_audio">소리만 · 눌러서 중지</string>
    <string name="widget_on_sub_both">소리 + 화면 · 눌러서 중지</string>
</resources>
